# Copy to backend/.env for local development. Never commit the real file.
ENVIRONMENT=development

OPENCAGE_API_KEY=
# Must have "Places API (New)" enabled in Google Cloud.
GOOGLE_API_KEY=
# RapidAPI key subscribed to the apidojo "Booking" API. AIRBNB_API_KEY also works.
RAPIDAPI_KEY=

# Optional: share caches and rate limits between workers.
# REDIS_URL=redis://localhost:6379/0

# Optional: only if a frontend on another origin calls this API from the browser.
# CORS_ORIGINS=https://remoteradar.net,https://www.remoteradar.net

# Optional: site-wide daily caps on paid/quota-limited providers (0 = no cap).
# GOOGLE_PLACES_DAILY_LIMIT=1000
# OPENCAGE_DAILY_LIMIT=2500
# BOOKING_DAILY_LIMIT=500

# Optional: SQLite file for popular-city totals and daily usage counts. Defaults to
# data/popular.db at the repo root; if that folder doesn't exist, counts stay in memory.
# STATS_DB_PATH=../data/popular.db
