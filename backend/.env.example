# Copy to backend/.env for local development. Never commit the real file.
ENVIRONMENT=development

OPENCAGE_API_KEY=
# Must have "Places API (New)" enabled in Google Cloud.
GOOGLE_API_KEY=
# RapidAPI key subscribed to the apidojo "Booking" API. AIRBNB_API_KEY also works.
RAPIDAPI_KEY=

# Optional: share caches and rate limits between workers.
# REDIS_URL=redis://localhost:6379/0

# Optional: only if the frontend is hosted on a different origin than the API.
# CORS_ORIGINS=https://remoteradar.net,https://www.remoteradar.net
